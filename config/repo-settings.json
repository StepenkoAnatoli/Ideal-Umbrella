            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/context_check.py\"; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
