{
  "autoCompactWindow": 250000,
  "skillListingBudgetFraction": 0.005,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/PC/AppData/Local/Programs/Python/Python314/python.exe\" -I \"C:/Users/PC/.claude/ballast/context_check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Artifact",
      "ScheduleWakeup",
      "ReportFindings",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "mcp__visualize",
      "mcp__visualize__show_widget",
      "mcp__visualize__read_me"
    ]
  }
}
