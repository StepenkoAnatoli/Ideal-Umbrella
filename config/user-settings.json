{
  "autoCompactWindow": 250000,
  "skillListingBudgetFraction": 0.005,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/ballast/context_check.py || exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Artifact",
      "ScheduleWakeup",
      "ReportFindings",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills"
    ]
  }
}